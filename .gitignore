# Files to ignore when considering what GIT should commit.

# ---------------------------------------------------------------------------
# Visual Studio / IDE state
# ---------------------------------------------------------------------------
.vs/
ipch/
*.suo
*.user
*.sln.docstates
*.sdf
*.opensdf
*.idb

# ---------------------------------------------------------------------------
# Compiler / linker intermediates and outputs
# ---------------------------------------------------------------------------
*.obj
*.pch
*.tlog
*.log
*.scc
*.exp
*.ilk
*.lastbuildstate
*.pdb
*.recipe
*.FileListAbsolute.txt

# Intermediate output directories used by VPC-generated .vcxproj files
# (e.g. Release_mod_episodic/, Release_dx9_mod_episodic/, Debug_mod_episodic/, obj_win32/)
Release*/
Debug*/
obj*/

# ---------------------------------------------------------------------------
# VPC / Visual Studio generated project files
# ---------------------------------------------------------------------------
*.vcxproj
*.vcxproj.filters
*.vpc_crc
*.vpc.sentinel
*.sln

# ---------------------------------------------------------------------------
# Libraries built from projects in this tree into src/lib/public.
# (Shipped prebuilt libs such as tier0, vstdlib, steam_api, libcurl,
#  libprotobuf, libz, nvtristrip, etc. stay tracked on purpose!)
# ---------------------------------------------------------------------------
src/lib/public/mathlib.lib
src/lib/public/raytrace.lib
src/lib/public/tier1.lib
src/lib/public/vgui_controls.lib
src/lib/public/fgdlib.lib
src/lib/public/client.lib
src/lib/public/server.lib

# ---------------------------------------------------------------------------
# Compiled game binaries (everything the build drops into game/*/bin)
# ---------------------------------------------------------------------------
game/*/bin/

# ---------------------------------------------------------------------------
# Compiled shaders (.vcs) and shader build intermediates.
# Sources are the *.fxc files; regenerate outputs with buildshaders.bat.
# ---------------------------------------------------------------------------
*.vcs
fxctmp9*/
src/materialsystem/stdshaders/filelist.txt
src/materialsystem/stdshaders/filestocopy.txt
src/materialsystem/stdshaders/filelistgen.txt
src/materialsystem/stdshaders/inclist.txt
src/materialsystem/stdshaders/vcslist.txt
src/materialsystem/stdshaders/uniquefilestocopy.txt
src/materialsystem/stdshaders/makefile.*
src/materialsystem/swarmshaders/filelist.txt
src/materialsystem/swarmshaders/filestocopy.txt
src/materialsystem/swarmshaders/filelistgen.txt
src/materialsystem/swarmshaders/inclist.txt
src/materialsystem/swarmshaders/vcslist.txt
src/materialsystem/swarmshaders/uniquefilestocopy.txt
src/materialsystem/swarmshaders/makefile.*

# ---------------------------------------------------------------------------
# OSX/Linux build products
# ---------------------------------------------------------------------------
*.mak
*.xcodeproj/
!devtools/*.mak
!utils/smdlexp/smdlexp.mak
client.so
client.so.dbg
server.so
server.so.dbg
server_srv.so
server_srv.so.dbg
client.dylib
client.dylib.dSYM/
server.dylib
server.dylib.dSYM/

# ---------------------------------------------------------------------------
# Files generated by running the game/mod
# ---------------------------------------------------------------------------
config.cfg
*.cache
screenshots/
voice_ban.dt

# Temporary files
*.tmp

